# Toolchain: native C++ compiler on Linux (ARM)

ROOT  := $(abspath ..)
DIST  := $(ROOT)/dist
LIB   := libspore_parser.a
SRCS  := $(wildcard source/*.cpp)

CXX   ?= c++
AR    ?= ar

CXXFLAGS_COMMON  := -std=c++17 -Iinclude -Isource
CXXFLAGS_RELEASE := $(CXXFLAGS_COMMON) -O2 -DNDEBUG
CXXFLAGS_DEBUG   := $(CXXFLAGS_COMMON) -g -O0 -DDEBUG

RELEASE_OBJS := $(patsubst source/%.cpp,source/%.o,$(SRCS))
DEBUG_OBJS   := $(patsubst source/%.cpp,source/%_d.o,$(SRCS))

.PHONY: check analyze release debug clean

THIS_MAKEFILE := $(lastword $(MAKEFILE_LIST))

release: $(DIST)/$(LIB)
debug:   $(DIST)/$(LIB_D)

$(DIST)/$(LIB): $(RELEASE_OBJS) | $(DIST)
	$(AR) rcs $@ $^

$(DIST)/$(LIB_D): $(DEBUG_OBJS) | $(DIST)
	$(AR) rcs $@ $^

source/%.o: source/%.cpp
	$(CXX) $(CXXFLAGS_RELEASE) -c $< -o $@

source/%_d.o: source/%.cpp
	$(CXX) $(CXXFLAGS_DEBUG) -c $< -o $@

$(DIST):
	@mkdir -p $@

clean:
	@rm -f $(DIST)/$(LIB) $(DIST)/$(LIB_D) $(RELEASE_OBJS) $(DEBUG_OBJS)

include Makefile.test

check:
	@$(MAKE) -f $(THIS_MAKEFILE) clean
	@$(MAKE) -f $(THIS_MAKEFILE) release
	@$(MAKE) -f $(THIS_MAKEFILE) clean-test
	@$(MAKE) -f $(THIS_MAKEFILE) test

analyze:
	@echo "==> No analysis checks configured."
